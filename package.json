{
  "name": "drawi",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Drawi - laboratorio de dibujo y materia 2.5D (inspirado en Alchemy / Webchemy)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "smoke": "node scripts/run-smoke.mjs",
    "test": "npm run check && npm run smoke",
    "verify:3d": "npm run build && node scripts/verify-render3d.mjs",
    "verify:save": "node scripts/verify-save.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "puppeteer": "^25.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
